# Pekerja sinyal crypto AIDSS (aidss_signals). MATI secara bawaan.
# Hanya TOP_N yang punya nilai bawaan (5), karena Anda yang menetapkannya. Semua angka lain wajib Anda isi;
# nilai di bawah hanya contoh bentuk (80% dan horizon 14d+30d adalah pilihan Anda, sisanya bukan saran).
AIDSS_SIGNALS_ENABLED=false

# SHADOW (bawaan): sinyal hanya dicatat. PUBLISH: dikirim ke klien yang tersambung; butuh konfirmasi dan token.
AIDSS_SIGNALS_MODE=SHADOW
# AIDSS_SIGNALS_CONFIRM_PUBLISH=yes
# Token yang dipakai klien CryptoSpike (kolom Client Token); minimal 16 karakter. Rahasiakan.
# AIDSS_SIGNALS_CLIENT_TOKEN=
# AIDSS_SIGNALS_HOST=127.0.0.1
# AIDSS_SIGNALS_PORT=3099

# Emiten: daftar tetap dari Anda ditambah N koin volume 24 jam terbesar (default 5; 0 = tanpa daftar dinamis; maks 50).
AIDSS_SIGNALS_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# AIDSS_SIGNALS_TOP_N=5
# Syarat likuiditas: volume 24 jam minimum (USDT) agar koin dipindai.
AIDSS_SIGNALS_MIN_QUOTE_VOLUME_USDT=50000000

# Horizon stock-pick yang menentukan sinyal (pilihan Anda: swing) dan ambang skor (pilihan Anda: 80%).
AIDSS_SIGNALS_HORIZONS=14d,30d
AIDSS_SIGNALS_MIN_SCORE_RATIO=0.8

# Level mekanis (stock pick hanya menamai kondisi, tidak menetapkan stop atau target).
AIDSS_SIGNALS_ATR_STOP_MULTIPLE=2.5
AIDSS_SIGNALS_TP_R1=1.5
AIDSS_SIGNALS_TP_R2=2.5
AIDSS_SIGNALS_TP_R3=4

# Peninjau AI lewat gateway LLM AIDSS (penyedia diatur di layar admin). AI hanya bisa menolak.
AIDSS_SIGNALS_AI_MIN_SCORE=70
AIDSS_SIGNALS_AI_MAX_CALLS=10
