# ============================================================================
# Mesin strategi lokal (CryptoSpike Client). Tempel ke .env untuk menyalakan.
# MATI secara bawaan. TIDAK ADA angka bawaan: setiap angka di bawah wajib Anda isi sendiri.
# Nilai di bawah hanya contoh bentuk, bukan saran dan bukan hasil penyetelan.
# ============================================================================
LOCAL_ENGINE_ENABLED=false

# SHADOW (bawaan): sinyal hanya dicatat di log, tidak pernah dikirim ke bursa.
# EXECUTE: sinyal diteruskan ke eksekutor klien, DAN butuh LOCAL_ENGINE_CONFIRM_EXECUTE=yes.
# Eksekusi tetap tunduk pada pengaturan per bursa (autoExecute, dry-run, filter koin, batas posisi).
LOCAL_ENGINE_MODE=SHADOW
# LOCAL_ENGINE_CONFIRM_EXECUTE=yes

# Simbol (format Binance), dipisah koma. Tokocrypto memakai simbol yang sama lewat normalisasi klien.
LOCAL_ENGINE_SYMBOLS=BTCUSDT,ETHUSDT

# Parameter aturan masuk (EMA + ADX + konfirmasi DI). Semua wajib.
LOCAL_ENGINE_EMA_FAST=20
LOCAL_ENGINE_EMA_SLOW=50
LOCAL_ENGINE_ADX_PERIOD=14
LOCAL_ENGINE_ADX_THRESHOLD=25
LOCAL_ENGINE_ATR_PERIOD=14
LOCAL_ENGINE_ATR_STOP_MULTIPLE=2.5
LOCAL_ENGINE_DI_MARGIN=0
# Target sebagai kelipatan R (jarak entry ke stop); harus 0 < R1 < R2 < R3.
LOCAL_ENGINE_TP_R1=1.5
LOCAL_ENGINE_TP_R2=2.5
LOCAL_ENGINE_TP_R3=4

# Sumber candle (endpoint publik, tanpa kunci). Bawaan https://api.binance.com
# LOCAL_ENGINE_KLINES_BASE=https://api.binance.com

# ----------------------------------------------------------------------------
# Penilai AI (opsional, mati bawaan). AI HANYA menilai kandidat dari aturan di atas: skor 0-100 dan
# TAKE/SKIP. Ia tidak membuat sinyal, tidak menyentuh harga, ukuran, stop, atau target. Gagal (error,
# timeout, jawaban cacat) = kandidat dibuang. Yang dikirim ke penyedia AI hanya angka pasar kandidat.
# Tujuan: api.anthropic.com (tujuan keluar baru; izinkan di firewall bila ada daftar putih).
# ----------------------------------------------------------------------------
LOCAL_ENGINE_AI_ENABLED=false
# ANTHROPIC_API_KEY=isi-di-.env-saja-jangan-di-commit
# LOCAL_ENGINE_AI_MODEL=isi-nama-model-yang-Anda-pilih
# Kandidat hanya jadi sinyal bila AI memberi TAKE dan skor >= angka ini (1-100). Skor ikut dikirim
# sebagai `score`, jadi filter minScore Binance di klien juga bekerja.
# LOCAL_ENGINE_AI_MIN_SCORE=70
# Batas panggilan AI per putaran (1-50), pengaman biaya.
# LOCAL_ENGINE_AI_MAX_CALLS_PER_TICK=5
