# The crypto signal worker (aidss_signals, ADR-065). Only the platform's core dependencies plus
# python-socketio: no torch, no Kronos, no test tooling, so the image stays small and separate from
# the API image. Runs as an unprivileged user and keeps its state in /data.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip \
    && pip install ".[signals]" \
    && useradd --uid 1000 --create-home app \
    && mkdir /data && chown app:app /data

USER app
ENV AIDSS_SIGNALS_DATA_DIR=/data
VOLUME ["/data"]

CMD ["python", "-m", "aidss_signals", "serve"]
