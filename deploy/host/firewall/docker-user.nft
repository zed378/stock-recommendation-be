# DRAFT, NOT APPLIED. Stage 1 values from the owner's answers of 2026-11-17 (see
# 08-HOST-FIREWALL-PLAN.md, "Owner decisions recorded"). Not validated by nft, never loaded.
# Equivalent to DOCKER-USER filtering, without editing Docker-owned tables.
# Stage 1 scope: SSH (22) and Portainer (8000, 9443) only. No other port is touched.
# IPv6 sets stay empty on purpose: new remote IPv6 is denied for these ports.
# Netbird peers are admitted by interface (wt0), not by address range, so no netbird CIDR is listed.
table inet aidss_host_draft {
    set ssh_v4 {
        type ipv4_addr
        flags interval
        elements = { 10.1.101.0/24 }
    }
    set ssh_v6 {
        type ipv6_addr
        flags interval
        # empty: owner chose to deny new remote IPv6
    }
    set lan_v4 {
        type ipv4_addr
        flags interval
        elements = { 10.1.101.0/24 }
    }
    set lan_v6 {
        type ipv6_addr
        flags interval
        # empty: owner chose to deny new remote IPv6
    }
    set managed_tcp {
        type inet_service
        # Only ports whose owner has confirmed a restriction: Portainer.
        elements = { 8000, 9443 }
    }
    chain input_guard {
        type filter hook input priority -10; policy accept;
        iifname "lo" accept
        ct state established,related accept
        # Existing netbird access is preserved, subject to owner review of its ACLs.
        iifname "wt0" accept
        ip saddr @ssh_v4 tcp dport 22 accept
        ip6 saddr @ssh_v6 tcp dport 22 accept
        tcp dport 22 drop
        # Host java 6547 is intentionally not restricted without identification/approval.
    }
    chain forward_guard {
        type filter hook forward priority -10; policy accept;
        ct state established,related accept
        # Only incoming external interfaces are scoped; bridge traffic is left alone.
        iifname { "enp1s0", "enp2s0", "wt0" } jump published_guard
    }
    chain published_guard {
        # Match original host port after DNAT, not the container's translated port.
        iifname "wt0" return
        meta l4proto tcp ip saddr @lan_v4 ct original proto-dst @managed_tcp return
        meta l4proto tcp ip6 saddr @lan_v6 ct original proto-dst @managed_tcp return
        meta l4proto tcp ct original proto-dst @managed_tcp drop
        return
    }
}
