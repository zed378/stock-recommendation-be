# DRAFT, NOT APPLIED. Review 08-HOST-FIREWALL-PLAN.md before rendering a policy.
# Equivalent to DOCKER-USER filtering, without editing Docker-owned tables.
# All source addresses are placeholders: fill from owner's answers (isi dari jawaban pemilik).
# Empty sets intentionally grant no new remote access. Do not load this draft.
table inet aidss_host_draft {
    set ssh_v4 {
        type ipv4_addr
        flags interval
        # elements = { OWNER_APPROVED_IPV4_OR_CIDR } # isi dari jawaban pemilik
    }
    set ssh_v6 {
        type ipv6_addr
        flags interval
        # elements = { OWNER_APPROVED_IPV6_OR_CIDR } # isi dari jawaban pemilik
    }
    set lan_v4 {
        type ipv4_addr
        flags interval
        # elements = { OWNER_APPROVED_LAN_CIDR } # isi dari jawaban pemilik
    }
    set lan_v6 {
        type ipv6_addr
        flags interval
        # elements = { OWNER_APPROVED_LAN_IPV6_CIDR } # isi dari jawaban pemilik
    }
    set managed_tcp {
        type inet_service
        # Populate ONLY ports whose owner has confirmed a restriction.
    }
    chain input_guard {
        type filter hook input priority -10; policy accept;
        iifname "lo" accept
        ct state established,related accept
        # Existing netbird access is preserved, subject to owner review of its ACLs.
        iifname "wt0" accept
        ip saddr @ssh_v4 tcp dport 22 accept
        ip6 saddr @ssh_v6 tcp dport 22 accept
        tcp dport 22 drop
        # Host java 6547 is intentionally not restricted without identification/approval.
    }
    chain forward_guard {
        type filter hook forward priority -10; policy accept;
        ct state established,related accept
        # Only incoming external interfaces are scoped; bridge traffic is left alone.
        iifname { "enp1s0", "enp2s0", "wt0" } jump published_guard
    }
    chain published_guard {
        # Match original host port after DNAT, not the container's translated port.
        iifname "wt0" return
        meta l4proto tcp ip saddr @lan_v4 ct original proto-dst @managed_tcp return
        meta l4proto tcp ip6 saddr @lan_v6 ct original proto-dst @managed_tcp return
        meta l4proto tcp ct original proto-dst @managed_tcp drop
        return
    }
}
