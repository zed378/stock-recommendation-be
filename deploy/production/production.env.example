# Environment for deploy/production/docker-compose.production.yml. Copy to `.env` beside the compose file, fill in, then `chmod 600 .env`.
# Names only: this file holds no value. A required name left empty makes `docker compose` refuse to start (that is on purpose).
# Never commit the filled copy, and never put it inside a backup that travels with the database dump.

# ----- Required: secrets (move them from the old host byte for byte; see docs/10-OPERATIONS/09-MIGRATION-RUNBOOK.md) -----
# The signing key of the analysis API and the key stored provider credentials are encrypted with. A different value logs everybody out
# and makes every stored provider key unreadable (security/secrets.py).
AIDSS_JWT_SECRET=
# Initial superuser password, read only when the data directory is empty. After a restore the dump's role passwords apply.
POSTGRES_PASSWORD=
# SQLAlchemy URLs, host `postgres`, database `aidss`. The roles and their passwords come from the dump (aidss_app, trader_rw).
# postgresql+psycopg://aidss_app:<password>@postgres:5432/aidss
AIDSS_APP_DATABASE_URL=
# postgresql+psycopg://trader_rw:<password>@postgres:5432/aidss
AIDSS_TRADER_DATABASE_URL=
# Absolute path of the Trader master key file on THIS host (mode 0600, owned by the user the Trader runs as). Moved separately,
# never with the database dump (ADR-014, ADR-029, runbook R10).
AIDSS_TRADER_MASTER_KEY_PATH=

# ----- Required: what to run (a commit tag or a digest; never `latest` for the Trader) -----
AIDSS_API_IMAGE=
AIDSS_FRONTEND_IMAGE=
AIDSS_TRADER_IMAGE=

# ----- Used by operator scripts, not by Compose (migrations and the host liveness script) -----
# AIDSS_TRADER_MIGRATION_DATABASE_URL=postgresql+psycopg://trader_owner:<password>@postgres:5432/aidss
# AIDSS_TRADER_MONITOR_DATABASE_URL=postgresql+psycopg://trader_monitor:<password>@postgres:5432/aidss

# ----- Optional: the Trader -----
# AIDSS_TRADER_UID=1000
# AIDSS_TRADER_GID=1000
# AIDSS_TRADER_INSTANCE_NAME=trader-1
# AIDSS_TRADER_EXCHANGE_BASE_URL= (empty: no exchange client; leave empty until T2-07)
# AIDSS_TRADER_PUBLIC_BASE_URL=

# ----- Optional: PostgreSQL image (pin a digest on the new host; a moving tag recreates the container on the next `up`) -----
# AIDSS_POSTGRES_IMAGE=pgvector/pgvector:pg16

# ----- Optional: application settings. Uncomment to change; the defaults are what runs today unless the old host's .env says otherwise -----
# Copy the old host's values for these (`AIDSS_ENVIRONMENT`, the provider switches, the AI endpoint and model, API keys for market data):
# the old values were not all defaults, so a filled copy of the old .env is the source of truth, not this list.
# AIDSS_ACCESS_TOKEN_TTL_MINUTES=60
# AIDSS_AI_API_KEY=
# AIDSS_AI_BASE_URL=https://api.openai.com/v1
# AIDSS_AI_CHAT_MODEL=gpt-4o-mini
# AIDSS_AI_EMBEDDING_MODEL=
# AIDSS_AI_PROVIDER=openai_compatible
# AIDSS_AI_SELF_HOSTED=false
# AIDSS_AI_TIMEOUT_SECONDS=300
# AIDSS_EODHD_API_KEY=
# AIDSS_ALPHAVANTAGE_API_KEY=
# AIDSS_ALPHAVANTAGE_PREMIUM=false
# AIDSS_ALPHAVANTAGE_SYMBOL_SUFFIX=.JKT
# AIDSS_BUDGET_WARNING_THRESHOLD=0.8
# AIDSS_COMPOSITE_FUNDAMENTALS_PROVIDER=idx
# AIDSS_COMPOSITE_PRICE_PROVIDER=yahoo
# AIDSS_DAILY_AI_BUDGET=
# AIDSS_DEBUG=false
# AIDSS_EMBEDDING_DIMENSIONS=1536
# AIDSS_ENABLE_HSTS=false
# AIDSS_ENVIRONMENT=development
# AIDSS_FINNHUB_API_KEY=
# AIDSS_FUNDAMENTALS_DAILY_QUOTA=25
# AIDSS_FUNDAMENTALS_MAX_ENQUEUED_PER_TICK=5
# AIDSS_FUNDAMENTALS_REFRESH_INTERVAL_DAYS=30
# AIDSS_IDX_IMPERSONATE=chrome120
# Optional outbound proxy for the IDX adapter only; may hold credentials, so keep it in this file.
# AIDSS_IDX_PROXY_URL=
# AIDSS_JSON_LOGS=true
# AIDSS_JWT_ALGORITHM=HS256
# AIDSS_LOCAL_STORAGE_ROOT=/app/var/storage
# AIDSS_LOG_LEVEL=INFO
# AIDSS_MARKET_DATA_PROVIDER=composite
# AIDSS_MIN_SCHEDULE_INTERVAL_SECONDS=300
# AIDSS_NEWS_PROVIDER=rss
# AIDSS_RATE_LIMIT_PER_MINUTE=120
# AIDSS_STORAGE_PROVIDER=local
# AIDSS_YAHOO_SYMBOL_SUFFIX=.JK
