# Copy to .env for local development. Never commit a filled-in .env:
# credentials belong in a secret manager (Section 13).
#
# `docker compose` reads .env from this directory automatically, and
# docker-compose.yml gives every setting a documented default - so only put
# here what differs from those defaults.
#
# One rule worth knowing: an EMPTY value means "not set", not "the empty
# value". Environment variables are strings and have no null, so a blank
# AIDSS_DAILY_AI_BUDGET means no ceiling rather than a ceiling of zero. That
# holds for every optional setting below.
#
# The frontend container needs nothing from this file. Vite substitutes its
# variables at build time, and the bundle calls /api on its own origin, which
# nginx proxies to the API container by service name.

AIDSS_ENVIRONMENT=development
AIDSS_DEBUG=false
AIDSS_DATABASE_URL=postgresql+psycopg://aidss:aidss@localhost:5432/aidss

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIDSS_JWT_SECRET=dev-only-change-me
AIDSS_ACCESS_TOKEN_TTL_MINUTES=60

# Active provider selection (Section 7). Changing a provider is a config
# change, never a code change.
#
# `yahoo` is the default for real use: free, no API key, and the only such
# source with usable IDX coverage. It is an UNOFFICIAL endpoint - see the
# note under AIDSS_YAHOO_SYMBOL_SUFFIX below. Use `fixture` for offline or
# deterministic runs.
#
# Set this to `composite` once you have an Alpha Vantage key. Yahoo serves
# prices and answers 401 on fundamentals; Alpha Vantage serves fundamentals
# and allows 25 requests a day, which is useless for prices and ample for
# figures that change quarterly. The composite draws each half from the
# provider that can actually supply it - see the two settings below.
AIDSS_MARKET_DATA_PROVIDER=yahoo
AIDSS_NEWS_PROVIDER=rss
AIDSS_AI_PROVIDER=openai_compatible
AIDSS_STORAGE_PROVIDER=local

# Market suffix for Yahoo symbols. IDX equities are `.JK` (BBCA -> BBCA.JK).
# Set to empty for US symbols; a ticker that already carries a suffix is never
# rewritten, so non-IDX assets can be registered with their explicit symbol.
#
# Accepted trade-off, recorded deliberately: Yahoo's chart endpoint is
# undocumented and its terms restrict automated commercial use (Section 6.1).
# It can change or start refusing requests without notice. The adapter reports
# those failures clearly rather than pretending they are data problems, and
# swapping to an official or licensed IDX feed is a change to
# AIDSS_MARKET_DATA_PROVIDER alone.
AIDSS_YAHOO_SYMBOL_SUFFIX=.JK

# Used only when AIDSS_MARKET_DATA_PROVIDER=composite. Neither half may itself
# be `composite`; that is refused at startup rather than left to recurse.
#
# `idx` is the fundamentals half for Indonesian equities. Alpha Vantage was
# tested against a real key and publishes NOTHING for IDX symbols - BBCA.JKT,
# BBCA.JK, and BBRI.JKT all come back empty - so it is the right choice only
# for a watchlist of US equities.
AIDSS_COMPOSITE_PRICE_PROVIDER=yahoo
AIDSS_COMPOSITE_FUNDAMENTALS_PROVIDER=idx

# The IDX adapter reads the exchange's own public financial statistics. The
# endpoint sits behind Cloudflare and refuses an ordinary HTTP client, so the
# adapter uses curl_cffi to present a browser's TLS fingerprint. What that gets
# past is bot management: there is no account, no credential, and no paywall
# here - IDX publishes these figures for the investing public.
#
# What it does NOT clear is IDX's terms, which prohibit redistributing this
# data to third parties commercially. Sound for personal research; revisit
# before the platform is used more widely (Section 13).
#
# This is the setting most likely to need changing when the adapter breaks.
AIDSS_IDX_IMPERSONATE=chrome

# Alpha Vantage: the fundamentals source. A free key is issued in under a
# minute at https://www.alphavantage.co/support/#api-key. Free tier is 25
# requests per day - fine for fundamentals, not for prices.
#
# Coverage outside US equities is uneven. If Alpha Vantage publishes nothing
# for an IDX ticker the collector reports it as unsupported and the Fundamental
# Analyzer skips, saying so - it does not fail, and it does not invent.
# Confirm coverage for your own tickers with: pytest -m network
AIDSS_ALPHAVANTAGE_API_KEY=

# Jakarta is `.JKT` on Alpha Vantage, not Yahoo's `.JK`. Separate settings
# because the suffixes genuinely differ per provider.
AIDSS_ALPHAVANTAGE_SYMBOL_SUFFIX=.JKT

# Optional: Finnhub, an official documented API with clear rate limits, for
# when a source of record is needed rather than a free one.
AIDSS_FINNHUB_API_KEY=

# Any OpenAI-compatible endpoint works here: OpenAI, Azure OpenAI, Ollama,
# vLLM, LM Studio, Groq, DeepSeek, OpenRouter (Section 12.1).
AIDSS_AI_BASE_URL=https://api-ai.bodha.co.id/
AIDSS_AI_API_KEY=sk-1234
AIDSS_AI_CHAT_MODEL=Qwen/Bodha

# Leave EMPTY when the endpoint serves no embedding model.
#
# Many self-hosted gateways front chat-only backends and answer /embeddings
# with 404 for every model they advertise - naming a chat model here does not
# help, it just spends a failed round trip per batch and can trip the gateway's
# own rate limiter. Empty says so up front.
#
# Retrieval then runs on BM25 alone, which is a supported configuration rather
# than a broken one: exact-token search - a ticker, a metric name, a ratio - is
# unaffected, and that is most of what this domain asks. What is lost is
# paraphrase matching, where a passage answers the question while sharing none
# of its words.
AIDSS_AI_EMBEDDING_MODEL=

AIDSS_LOCAL_STORAGE_ROOT=./var/storage
