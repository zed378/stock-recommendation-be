# What the API image does NOT need.
#
# The frontend has its own build context and its own ignore file
# (frontend/.dockerignore), so this file excludes the frontend entirely: the
# API image serves JSON, not HTML, and shipping a React source tree inside it
# would only enlarge the image and its attack surface.

# --- Version control -------------------------------------------------------
.git
.gitignore
.github/

# --- Editors ---------------------------------------------------------------
.vscode/
.idea/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/

# --- Testing and linting ---------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/

# --- Build artefacts -------------------------------------------------------
build/
dist/
*.whl

# --- Frontend --------------------------------------------------------------
# Whole tree, not just node_modules: it is a separate image.
frontend/
openapi.json

# --- Application data ------------------------------------------------------
var/
*.db
*.sqlite3

# --- Secrets ---------------------------------------------------------------
# Every real env file. `.env.example` carries no secrets but is documentation
# rather than runtime input, so it is excluded too - configuration reaches the
# container through the environment, never through a baked-in file.
.env
.env.*

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Documentation ---------------------------------------------------------
Dokumen_*.md
docs/

# --- Docker itself ---------------------------------------------------------
docker-compose*.yml
Dockerfile*
.dockerignore

# --- Misc ------------------------------------------------------------------
*.log
*.tmp
*.bak
*~
*.swp
