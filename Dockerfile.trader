FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Only the Trader's package, its dependency lock, and its migrations. No analysis
# code, no tests, no torch, and no secret or owner number: the image may be public
# during development (ADR-030) and everything pushed while public must be assumed
# copied.
#
# Dependencies come from a hash-pinned lock file (ADR-050) compiled from
# requirements-trader.in, the Trader's own direct dependencies (ADR-053): `--require-hashes` makes the
# build fail rather than pick a different version or accept a changed file, and `--no-deps`
# keeps pip from resolving anything the lock does not list. The package itself is not
# pip-installed: building it would fetch an unpinned build backend, so its source is put on
# PYTHONPATH instead.
COPY requirements-trader.lock ./
RUN pip install --require-hashes --no-deps -r requirements-trader.lock
COPY src/aidss_trader ./src/aidss_trader
ENV PYTHONPATH=/app/src

COPY alembic_trader.ini ./
COPY alembic_trader ./alembic_trader

RUN useradd --system --no-create-home trader
USER trader

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-m", "aidss_trader", "healthcheck"]

CMD ["python", "-m", "aidss_trader", "run"]
